{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage.schema.json",
  "title": "Security audit coverage ledger",
  "description": "coverage-ledger.json of a security-audit run. One row per subsystem in the audited scope. scripts/audit-artifacts.sh validates it deterministically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subsystem", "boundary", "files", "status", "reviewed_by", "findings"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+$" },
        "subsystem": { "$ref": "#/$defs/text" },
        "boundary": { "$ref": "#/$defs/text" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "status": { "enum": ["queued", "in_review", "covered", "skipped", "gap"] },
        "reviewed_by": {
          "type": "array",
          "items": { "enum": ["hunter", "verifier", "coverage_critic"] }
        },
        "findings": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
        },
        "reason": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["skipped", "gap"] } } },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "covered" } } },
          "then": {
            "properties": {
              "reviewed_by": { "contains": { "const": "hunter" } }
            }
          }
        }
      ]
    }
  }
}
